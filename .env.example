# Copy to .env.local (git-ignored) for local testing with `npm run ai:dev`.
# Never commit real values. On Vercel, set these in the project settings instead.

# --- AI (explainer, grounded answers, care search, lab report reader) ---
# Either an OpenAI key (used first when set)...
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# ...or Google Vertex AI (Gemini), with a service-account key that has the "Vertex AI User" role.
# Locally, point to the key file (keep it outside the repo). On Vercel, paste the file's contents into
# GCP_SERVICE_ACCOUNT_JSON instead.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/wiqaya/vertex-key.json
# GCP_SERVICE_ACCOUNT_JSON=
# VERTEX_MODEL=google/gemini-3-flash-preview
# GOOGLE_CLOUD_LOCATION=global
# The consent texts name the AI service. If you use OpenAI or Azure instead of Vertex AI, say so at build time:
# VITE_AI_PROVIDER=Microsoft Azure OpenAI
# ...or Azure OpenAI:
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
# Only for reasoning models (gpt-5 family): minimal | low | medium. Leave unset for gpt-4.1-mini / gpt-4o-mini.
# AZURE_OPENAI_REASONING_EFFORT=low

# --- Store for private doctor links, feedback counters and rate limits ---
# On Vercel, adding the "Upstash for Redis" integration sets these two for you.
# Locally they can stay empty: `npm run ai:dev` then uses an in-memory store that is emptied on exit.
KV_REST_API_URL=
KV_REST_API_TOKEN=
